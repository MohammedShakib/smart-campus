# CampusAI / GemBridge configuration
# Copy to .env and replace the placeholder key with a private GemBridge key.
GEMINI_API_KEY=gb_your_gembridge_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_API_BASE_URL=http://127.0.0.1:8081/v1

# Use this instead when connecting through Tailscale:
# GEMINI_API_BASE_URL=https://shakibs-pc.tail76a11b.ts.net/v1

# Railway / production deployment
# Railway provides PORT automatically; the app reads it through server.port=${PORT:8085}.
# For Railway MySQL, add these variables in the smart-campus service Variables tab:
# SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/${{MySQL.MYSQLDATABASE}}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=${{MySQL.MYSQLUSER}}
# SPRING_DATASOURCE_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
# SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
# Optional: change persisted login session lifetime.
# SMART_CAMPUS_SESSION_TIMEOUT=7d
# Optional QR public URL override:
# smart-campus.attendance-base-url=https://your-railway-domain.up.railway.app
