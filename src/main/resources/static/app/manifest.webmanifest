{
  "name": "Smart Campus",
  "short_name": "Smart Campus",
  "description": "Smart Campus web app for students, faculty, admins, and security teams.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "background_color": "#f8fafc",
  "theme_color": "#4f46e5",
  "orientation": "any",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/app/icons/smart-campus-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icons/smart-campus-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/icons/smart-campus-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
